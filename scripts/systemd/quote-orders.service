[Unit]
Description=Quote orders API (quote_orders_server.py) — cotações da mesa
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/web/rodolforomao.com.br/quote-orders
EnvironmentFile=/home/admin/web/rodolforomao.com.br/quote-orders/.env.quote-orders
ExecStart=/usr/bin/python3 /home/admin/web/rodolforomao.com.br/quote-orders/quote_orders_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
