[Unit]
Description=Portfolio Vault Server (vault_server.py)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/web/rodolforomao.com.br/vault-services
EnvironmentFile=/home/admin/web/rodolforomao.com.br/vault-services/.env.vault
ExecStart=/home/admin/web/rodolforomao.com.br/vault-services/venv/bin/python3 /home/admin/web/rodolforomao.com.br/vault-services/vault_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
