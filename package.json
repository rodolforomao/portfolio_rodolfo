  "scripts": {
    "start": "react-scripts start",
    "prebuild": "bash scripts/sync-dealer-tools.sh",
    "sync:tools": "bash scripts/sync-dealer-tools.sh",
    "start:analyses": "ANALYSES_HTTP_PORT=8769 python3 tools/analyses/scripts/serve_live.py",
    "start:liquid-pots": "bash scripts/start-liquid-pots.sh",
    "start:vault": "bash scripts/start-vault.sh",
    "start:relay": "bash scripts/start-relay.sh",
    "start:portfolio-api": "bash scripts/start-portfolio-api.sh",
    "start:dev": "bash scripts/start-dev.sh",
    "dev": "bash scripts/ensure-venv.sh && concurrently --names \"react,vault,relay\" --prefix-colors \"cyan,magenta,yellow\" \"npm run start\" \"npm run start:vault\" \"npm run start:relay\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "deploy:ssh": "bash scripts/deploy-ssh.sh",
    "deploy:vault": "bash scripts/deploy-vault-services.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "release": "bash scripts/release.sh",
    "verify:vault": "bash scripts/verify-vault-prod.sh",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "gh-pages": "^6.1.1"
  }
