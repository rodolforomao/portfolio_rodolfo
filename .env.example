# ===========================================
# Deploy para produção (SSH / rsync)
# ===========================================
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env
#
# O arquivo .env não é commitado (.gitignore).
# Nunca coloque senhas ou chaves privadas no .env;
# use chave SSH em ~/.ssh/ ou DEPLOY_SSH_KEY para apontar para um arquivo de chave.

# Host do servidor (IP ou domínio)
DEPLOY_SSH_HOST=seu-servidor.com

# Usuário SSH
DEPLOY_SSH_USER=deploy

# Porta SSH (opcional; padrão 22)
DEPLOY_SSH_PORT=22

# Caminho absoluto no servidor onde o build React é enviado (HestiaCP public_html)
DEPLOY_REMOTE_PATH=/home/admin/web/rodolforomao.com.br/public_html

# Serviços Python (fora do public_html) — vault_server + ws_relay
DEPLOY_VAULT_PATH=/home/admin/web/rodolforomao.com.br/vault-services

# Snippet nginx HestiaCP (proxy /api/vault/, /dealer-ws, etc.)
DEPLOY_NGINX_CONF_DIR=/home/admin/conf/web/rodolforomao.com.br

# Domínio público (verificação pós-deploy)
DEPLOY_PUBLIC_HOST=rodolforomao.com.br

# deploy-production.sh: 1 = inclui vault+relay (padrão) | 0 = só React
# DEPLOY_WITH_VAULT=1

# deploy-vault-services.sh: 1 = sobrescreve vault_data.db na VPS (cuidado!)
# VAULT_SYNC_DB=0

# Caminho para chave SSH (opcional; se não definir, usa ~/.ssh/id_rsa)
# DEPLOY_SSH_KEY=~/.ssh/id_rsa

# Senha SSH (opcional; use se não estiver usando chave. Requer: apt install sshpass)
# DEPLOY_SSH_PASSWORD=sua_senha

# ===========================================
# Dealer Console (/dealer)
# ===========================================
# Usuário e senha da tela de login (não commitar valores reais)
REACT_APP_DEALER_USER=admin
REACT_APP_DEALER_PASSWORD=troque-esta-senha

# Token WebSocket — mesmo valor de WS_BRIDGE_TOKEN no manager_dealer e no relay
REACT_APP_DEALER_WS_TOKEN=seu-token-secreto-forte

# URL do relay (local: ws://127.0.0.1:8765 | produção: wss://rodolforomao.com.br/dealer-ws)
# Docker (run-pc.sh): use host.docker.internal — já configurado no docker-compose.termux.yml
REACT_APP_DEALER_WS_URL=ws://127.0.0.1:8765

# IP da VPS (opcional) — aba Arquitetura em /dealer
# REACT_APP_VPS_IP=77.111.101.238

# ===========================================
# Vault Server (vault_server.py)
# ===========================================
# Token Bearer que o manager_dealer usa para chamar /admin/vault/
# Deve ser igual a VAULT_ADMIN_TOKEN no .env do manager_dealer
VAULT_ADMIN_TOKEN=troque-este-token-forte

# Porta onde vault_server.py escuta (nginx faz proxy de /api/vault/ e /vault-ws para cá)
VAULT_HTTP_PORT=8766

# Caminho do banco SQLite com os vault entries
VAULT_DB_PATH=./vault_data.db

# (Opcional) URL base da API do vault — deixe vazio para usar same-origin
# Em dev, o CRA proxy (package.json "proxy") encaminha para http://localhost:8766
# REACT_APP_VAULT_API_URL=
