# ===========================================
# Deploy para produção (SSH / rsync)
# ===========================================
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env
#
# O arquivo .env não é commitado (.gitignore).
# Nunca coloque senhas ou chaves privadas no .env;
# use chave SSH em ~/.ssh/ ou DEPLOY_SSH_KEY para apontar para um arquivo de chave.

# Host do servidor (IP ou domínio)
DEPLOY_SSH_HOST=seu-servidor.com

# Usuário SSH
DEPLOY_SSH_USER=deploy

# Porta SSH (opcional; padrão 22)
DEPLOY_SSH_PORT=22

# Caminho absoluto no servidor onde o build será enviado (pasta do site)
DEPLOY_REMOTE_PATH=/var/www/portfolio

# Caminho para chave SSH (opcional; se não definir, usa ~/.ssh/id_rsa)
# DEPLOY_SSH_KEY=~/.ssh/id_rsa

# Senha SSH (opcional; use se não estiver usando chave. Requer: apt install sshpass)
# DEPLOY_SSH_PASSWORD=sua_senha
